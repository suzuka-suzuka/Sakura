# Dependencies
node_modules/

# Build output
dist/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# Runtime data
data/
temp/

# User config (contains sensitive info like master QQ, cookies, etc.)
config/

# Ignore all plugins except system (demo plugin)
plugins/*
!plugins/system/
!plugins/sakura-plugin/
!plugins/sakura-plugin/**

# Frontend build output
dist-ssr/
*.local

# Environment variables
.env
.env.local
.env.*.local
.claude/settings.local.json
CLAUDE.md

# Local-only tests
test/

# 碧蓝档案对战：官方美术素材（角色立绘/Q版/头像、召唤物 Q 版）
# 数据和数值可以进仓库，美术资源不行 —— GitHub 的 DMCA 基本只打这个。
# 用 plugins/sakura-plugin/scripts/fetch-art.mjs 重新拉取即可。
#
# 写成两层通配而不是逐个列目录：加新素材类别（当初加 summons/ 就漏过一次）时
# 自动覆盖，不会因为忘了补一行就把官方图推上去。
plugins/sakura-plugin/resources/ba/*/*/
