node_modules/

# Build output
dist/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# Runtime data
data/
temp/

# User config (contains sensitive info like master QQ, cookies, etc.)
config/

# Ignore all plugins except system (demo plugin)
plugins/*
!plugins/system/
!plugins/sakura-plugin/
!plugins/sakura-plugin/**

# Frontend build output
dist-ssr/
*.local

# Environment variables
.env
.env.local
.env.*.local
.claude/settings.local.json
CLAUDE.md

# Local-only tests
test/

# 碧蓝档案对战：官方美术素材（角色立绘/Q版/头像、召唤物 Q 版）
# 数据和数值可以进仓库，美术资源不行 —— GitHub 的 DMCA 基本只打这个。
# 用 plugins/sakura-plugin/scripts/fetch-art.mjs 重新拉取即可。
#
# 写成两层通配而不是逐个列目录：加新素材类别（当初加 summons/ 就漏过一次）时
# 自动覆盖，不会因为忘了补一行就把官方图推上去。
plugins/sakura-plugin/resources/ba/*/*/
# 原作战斗状态图标（红/蓝/紫/黄那套），同样是官方美术
plugins/sakura-plugin/resources/ba/status/

# 例外：这两张 fetch-art.mjs **拉不到**，任何公开来源都没有，只能从游戏里自己提取
#   99999/chibi   静子的掩体（百夜堂小推车）—— SchaleDB 的召唤物路径全是 1543 字节占位图
#   KOTAMA/chibi  音濑 小玉的 Q 版 —— kivo 目录在，但 sd_model.png 连同一圈文件名全 404
# 不跟进仓库的话，换机器跑完 fetch-art 会独独缺这两个，只能手工传。
#
# **先放行目录再放行文件**：上面那条排的是「目录」，被排除的目录 git 根本不会往里看，
# 只写文件那一行是不生效的。KOTAMA 目录里另外两张（icon/portrait）拉得到，重新排掉。
!plugins/sakura-plugin/resources/ba/summons/99999/
plugins/sakura-plugin/resources/ba/summons/99999/*
!plugins/sakura-plugin/resources/ba/summons/99999/chibi.png
!plugins/sakura-plugin/resources/ba/characters/KOTAMA/
plugins/sakura-plugin/resources/ba/characters/KOTAMA/*
!plugins/sakura-plugin/resources/ba/characters/KOTAMA/chibi.png
